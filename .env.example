# Copy to .env and fill in. The .env file is gitignored.
# See also backend/.env.example for the full reference.

# --- Recipe extraction backend ---
# Options: claude (default), gemini
EXTRACTOR_BACKEND=claude

# Anthropic (required when EXTRACTOR_BACKEND=claude)
ANTHROPIC_API_KEY=

# Google / Gemini (required when EXTRACTOR_BACKEND=gemini or IMAGE_BACKEND=imagen)
# Also used by Gemini Flash for dish translation in all image backends.
GOOGLE_API_KEY=

# --- Image generation backend ---
# Options: imagen (default), together, local
IMAGE_BACKEND=imagen

# Together AI (required when IMAGE_BACKEND=together)
# TOGETHER_API_KEY=

# Local FLUX server URL (optional, for IMAGE_BACKEND=local)
# LOCAL_FLUX_URL=http://localhost:8500

# --- Database ---
# Optional: override the default DB path (data/recetary.db).
# RECETARY_DB=
