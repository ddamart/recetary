# --- LLM extraction backend ---
# Options: claude (default), gemini
EXTRACTOR_BACKEND=claude

# Claude (required when EXTRACTOR_BACKEND=claude)
ANTHROPIC_API_KEY=

# Google / Gemini (required when EXTRACTOR_BACKEND=gemini or IMAGE_BACKEND=imagen)
GOOGLE_API_KEY=

# --- Image generation backend ---
# Options: imagen (default), together, local
IMAGE_BACKEND=imagen

# Together AI (required when IMAGE_BACKEND=together)
TOGETHER_API_KEY=

# Local FLUX server URL (optional, for IMAGE_BACKEND=local)
LOCAL_FLUX_URL=http://localhost:8500

# --- Database ---
# SQLite path (default: data/recetary.db)
# RECETARY_DB=data/recetary.db
